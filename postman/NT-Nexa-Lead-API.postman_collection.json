{
  "info": {
    "name": "NT Nexa - Lead Management API",
    "_postman_id": "5b0c9f3e-6a54-4f0e-9d2a-1c7e2b9a4f10",
    "description": "Lead Management REST API (Laravel + Sanctum).\n\nQuick start:\n1. Set `base_url` (default http://127.0.0.1:8000/api).\n2. Run **Register** or **Login** - the token is saved automatically into `{{token}}`.\n3. All Lead requests use Bearer `{{token}}` (collection-level auth).\n4. **Create Lead** stores the new id in `{{lead_id}}` for Get/Update/Delete.\n5. **New Lead Webhook** is signed automatically with `{{webhook_secret}}` (must match LEAD_WEBHOOK_SECRET in .env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "lead_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "local-dev-webhook-secret",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Creates a user and returns a Sanctum token (saved to {{token}}).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Reviewer\",\n  \"email\": \"reviewer@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is success\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "    console.log(\"Sanctum token saved to collection variable {{token}}\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Returns a Sanctum token (saved to {{token}}). Seeded user: demo@example.com / password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is success\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "    console.log(\"Sanctum token saved to collection variable {{token}}\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "Returns the authenticated user."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revokes the token used for this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged out\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", \"\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "new",
                  "description": "new | contacted | qualified | closed",
                  "disabled": true
                },
                {
                  "key": "source",
                  "value": "website",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Paginated list. Optional filters: status, source. per_page 1-100 (default 15)."
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads"
              ]
            },
            "description": "Creates a lead. The new id is saved to {{lead_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"+923001234567\",\n  \"email\": \"ali@example.com\",\n  \"source\": \"website\",\n  \"status\": \"new\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lead created (201)\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "    pm.collectionVariables.set(\"lead_id\", json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Lead",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update Lead (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"+923001234567\",\n  \"email\": \"ali@example.com\",\n  \"source\": \"website\",\n  \"status\": \"contacted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Lead Status (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": "Partial update - only the provided fields change.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"qualified\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Webhook",
      "item": [
        {
          "name": "New Lead Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "leads"
              ]
            },
            "description": "Called by external systems. No bearer token; authenticated by the X-Webhook-Signature header (sha256=HMAC of the raw body), which the pre-request script computes. Creates the lead with status 'new' and triggers the mock WhatsApp/SMS notification (see storage/logs/laravel.log).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Ahmed\",\n  \"phone\": \"+923331112233\",\n  \"email\": \"sara@example.com\",\n  \"source\": \"facebook_ads\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sign the raw JSON body with HMAC-SHA256 using the shared webhook secret.",
                  "const secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const signature = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Webhook-Signature\", value: \"sha256=\" + signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lead received (201)\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}